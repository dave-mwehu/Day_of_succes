rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && myProfile().role == 'admin';
    }

    function isMember() {
      return isSignedIn() && myProfile().role == 'member';
    }

    match /users/{uid} {
      allow read: if isSignedIn() && (uid == request.auth.uid || isAdmin());
      allow write: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /publicStats/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /weekly_cycles/{cycleId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /member_cycles/{memberCycleId} {
      allow read: if isAdmin();
      allow read: if isMember() && resource.data.memberId == myProfile().memberId;
      allow create, update, delete: if isAdmin();
    }

    match /debt_adjustments/{adjustmentId} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    match /members/{memberId} {
      allow read: if isAdmin() || (isMember() && memberId == myProfile().memberId);
      allow write: if isAdmin();
    }

    match /deposits/{depositId} {
      allow read: if isAdmin();
      allow read: if isMember() && resource.data.memberId == myProfile().memberId;
      allow create, update, delete: if isAdmin();
    }

    match /notifications/{notificationId} {
      allow read: if isAdmin() || (isMember() && resource.data.uid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }
  }
}
